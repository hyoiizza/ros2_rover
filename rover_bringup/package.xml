<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>1.1.1</version>
  <description>Bringup package</description>
  <maintainer email="mgons@unileon.es">Miguel Ángel González Santamarta</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rover_motor_controller_cpp</depend>
  <!-- Manual driving: keyboard teleop -->
  <depend>rover_teleop</depend>
  <!-- Slamtec RPLIDAR C1 -->
  <depend>sllidar_ros2</depend>
  <!-- Orbbec Gemini 335 -->
  <depend>orbbec_camera</depend>
  <!-- Adafruit BNO085 9-DOF IMU -->
  <depend>bno08x_driver</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>