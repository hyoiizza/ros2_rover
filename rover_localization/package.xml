<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_localization</name>
  <version>1.1.1</version>
  <description>Localization package</description>
  <maintainer email="mgons@unileon.es">Miguel Ángel González Santamarta</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rtabmap</depend>
  <depend>rtabmap_ros</depend>
  <depend>robot_localization</depend>
  <!-- 2D lidar SLAM (driving map) -->
  <depend>slam_toolbox</depend>
  <!-- laser odometry: the rover has no wheel encoders -->
  <depend>rf2o_laser_odometry</depend>
  <depend>nav2_common</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>