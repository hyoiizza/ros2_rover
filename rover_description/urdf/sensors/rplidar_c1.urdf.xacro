<!-- Slamtec RPLIDAR C1 (360 deg DTOF, 0.05-12 m, 10 Hz, 5000 samples/s)
     Gazebo Classic version: the scan is published by libgazebo_ros_ray_sensor. -->
<robot name="sensor_rplidar_c1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_rplidar_c1" params="prefix parent *origin
                                                min_angle:=${-pi} max_angle:=${pi}
                                                samples:=500 update_rate:=10
                                                min_range:=0.05 max_range:=12.0">

    <!-- Housing: 55.6 x 55.6 x 41.3 mm. The scan plane sits ~28 mm above the
         base, so the body is drawn slightly below ${prefix}_link, which IS the
         scan frame (matches the driver's frame_id). -->
    <xacro:property name="rplidar_radius" value="0.0278" />
    <xacro:property name="rplidar_height" value="0.0413" />
    <xacro:property name="rplidar_visual_z" value="-0.0074" />

    <joint name="${prefix}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 ${rplidar_visual_z}" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${rplidar_radius}" length="${rplidar_height}" />
        </geometry>
        <material name="dark_gray" />
      </visual>
      <collision>
        <origin xyz="0 0 ${rplidar_visual_z}" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${rplidar_radius}" length="${rplidar_height}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.11" />
        <origin xyz="0 0 ${rplidar_visual_z}" rpy="0 0 0" />
        <inertia ixx="2.1e-5" ixy="0" ixz="0" iyy="2.1e-5" iyz="0" izz="4.2e-5" />
      </inertial>
    </link>

    <gazebo reference="${prefix}_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="${prefix}_link">
      <sensor name="rplidar_c1" type="gpu_ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <!-- 5000 samples/s at 10 Hz => 500 samples/turn (0.72 deg) -->
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <!-- Datasheet accuracy: +-30 mm -->
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="${prefix}_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
            <qos>
              <topic name="scan">
                <publisher>
                  <reliability>best_effort</reliability>
                </publisher>
              </topic>
            </qos>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${prefix}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
